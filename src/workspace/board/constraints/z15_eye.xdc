# Z15 base 1V1 schematic pp2/4/10/11 + ALIENTEK P2 camera and UART examples.
create_clock -period 20.000 -name sys_clk [get_ports sys_clk]
create_clock -period 20.833 -name cam_pclk [get_ports cam_pclk]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33} [get_ports sys_clk]
set_property -dict {PACKAGE_PIN G2 IOSTANDARD LVCMOS18} [get_ports reset_n]
set_property -dict {PACKAGE_PIN AA11 IOSTANDARD LVCMOS33} [get_ports {uart_rx}]
set_property -dict {PACKAGE_PIN AB11 IOSTANDARD LVCMOS33} [get_ports {uart_tx}]
set_property -dict {PACKAGE_PIN AA12 IOSTANDARD LVCMOS33} [get_ports {cam_scl}]
set_property -dict {PACKAGE_PIN AB12 IOSTANDARD LVCMOS33} [get_ports {cam_sda}]
set_property -dict {PACKAGE_PIN J7 IOSTANDARD LVCMOS18} [get_ports {cam_data[0]}]
set_property -dict {PACKAGE_PIN P3 IOSTANDARD LVCMOS18} [get_ports {cam_data[1]}]
set_property -dict {PACKAGE_PIN J6 IOSTANDARD LVCMOS18} [get_ports {cam_data[2]}]
set_property -dict {PACKAGE_PIN P2 IOSTANDARD LVCMOS18} [get_ports {cam_data[3]}]
set_property -dict {PACKAGE_PIN U1 IOSTANDARD LVCMOS18} [get_ports {cam_data[4]}]
set_property -dict {PACKAGE_PIN M2 IOSTANDARD LVCMOS18} [get_ports {cam_data[5]}]
set_property -dict {PACKAGE_PIN L7 IOSTANDARD LVCMOS18} [get_ports {cam_data[6]}]
set_property -dict {PACKAGE_PIN M1 IOSTANDARD LVCMOS18} [get_ports {cam_data[7]}]
set_property -dict {PACKAGE_PIN R8 IOSTANDARD LVCMOS18} [get_ports {cam_href}]
set_property -dict {PACKAGE_PIN U2 IOSTANDARD LVCMOS18} [get_ports {cam_pclk}]
set_property -dict {PACKAGE_PIN K7 IOSTANDARD LVCMOS18} [get_ports {cam_pwdn}]
set_property -dict {PACKAGE_PIN F4 IOSTANDARD LVCMOS18} [get_ports {cam_reset_n}]
set_property -dict {PACKAGE_PIN H8 IOSTANDARD LVCMOS18} [get_ports {cam_vsync}]
set_property -dict {PACKAGE_PIN E4 IOSTANDARD LVCMOS18} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN E3 IOSTANDARD LVCMOS18} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN AA16 IOSTANDARD TMDS_33} [get_ports {hdmi_clk_p}]
set_property -dict {PACKAGE_PIN AA17 IOSTANDARD TMDS_33} [get_ports {hdmi_clk_n}]
set_property -dict {PACKAGE_PIN AB16 IOSTANDARD TMDS_33} [get_ports {hdmi_data_p[0]}]
set_property -dict {PACKAGE_PIN AB17 IOSTANDARD TMDS_33} [get_ports {hdmi_data_n[0]}]
set_property -dict {PACKAGE_PIN AB21 IOSTANDARD TMDS_33} [get_ports {hdmi_data_p[1]}]
set_property -dict {PACKAGE_PIN AB22 IOSTANDARD TMDS_33} [get_ports {hdmi_data_n[1]}]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD TMDS_33} [get_ports {hdmi_data_p[2]}]
set_property -dict {PACKAGE_PIN V19 IOSTANDARD TMDS_33} [get_ports {hdmi_data_n[2]}]
set_property PULLUP true [get_ports {cam_sda uart_rx reset_n}]
# These slow control/status outputs are not sampled against an external clock.
set_false_path -to [get_ports {led[*] uart_tx cam_scl cam_sda cam_pwdn cam_reset_n}]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
