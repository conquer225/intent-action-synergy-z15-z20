obj-m += gldma_owner.o

# Explicit build variant for the validated integrated BD. Default retains
# the earlier isolated candidate's register map.
ifeq ($(COEXIST),1)
ccflags-y += -DGLDMA_COEXIST
endif

# Compile only against the exact board kernel build tree. Never load this
# candidate just because it compiles.
KDIR ?= /lib/modules/$(shell uname -r)/build
PWD := $(shell pwd)

all:
	$(MAKE) -C $(KDIR) M=$(PWD) COEXIST=$(COEXIST) modules

clean:
	$(MAKE) -C $(KDIR) M=$(PWD) clean
