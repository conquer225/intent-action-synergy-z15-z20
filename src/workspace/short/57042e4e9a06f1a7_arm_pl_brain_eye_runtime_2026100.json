        "134:             if menu is not None and state.phase!=\"selection\":",
        "135:                 menu.close();menu=None;selection=None",
        "136:             if buttons is not None:",
        "137:                 actions=buttons.poll(now)",
        "138:                 # Cancel has priority if both keys are pressed together.",
        "139:                 if \"pause\" in actions:",
        "140:                     restart.cancel()",
        "155:                     elif state.phase in (\"ready\",\"complete\",\"failed\",\"cancelled\",\"checked\",\"validated\",\"usable\",\"validation_failed\"):",
        "156:                         if begin(now,preview=not args.live):",
        "157:                             print(\"button=PS_KEY0 action=%s\"%(\"start_validation\" if validating else \"start_calibration\" if args.live else \"start_preview\"),flush=True)",
        "158:                     else:",
        "159:                         print(\"button=PS_KEY0 action=ignored_running\",flush=True)",
        "160:             try:",
        "201:                     if restart.pending:",
        "202:                         continue  # Old points/results/exit errors cannot mutate the new session.",
        "203:                     if event.get(\"kind\") not in (\"quality\",\"gaze\",\"direction_gaze\",\"horizontal_gaze\"):print(\"worker_event=\"+json.dumps(event),flush=True)",
        "204:                     if event.get(\"kind\")==\"ready\" and state.phase==\"connecting\":",
        "205:                         if args.relative_selection:",
        "206:                             state.phase=\"positioning\"",
        "217:                         state.detail=\"正在第 %d / %d 次采样，请继续看白点\"%(event[\"attempt\"],event[\"limit\"])",
        "218:                     elif event.get(\"kind\")==\"quality\":",
