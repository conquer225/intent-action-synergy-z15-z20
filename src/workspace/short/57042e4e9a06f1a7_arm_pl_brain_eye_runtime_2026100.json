        "228:                                 print(\"media_selection=\"+json.dumps(dict(action=menu.last_action,region=selection.selected,count=selection.confirmations,monotonic_ns=event.get(\"monotonic_ns\"))),flush=True)",
        "229:                         elif not args.local_media and selection.update_horizontal(event,time.monotonic()):",
        "230:                             print(\"selection_event=\"+json.dumps(dict(region=selection.selected,count=selection.confirmations,monotonic_ns=event.get(\"monotonic_ns\"),mode=\"relative\")),flush=True)",
        "259:                         state.detail=\"位置检查采样已结束，按 PS_KEY0 可重新连接\" if positioning else \"三个方向数据不足或未分开，请调整后重做\" if args.relative_selection else (\"%d 点采样完成，校准计算失败 0x%08X；请重新校准\"%(len(points),event.get(\"status\",0)) if computing and args.selection_test else \"模组处理未完成，错误 %s；可以移开视线\"%event.get(\"code\"))",
