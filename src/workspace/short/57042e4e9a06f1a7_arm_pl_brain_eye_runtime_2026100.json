        "67:     state = Validation() if validating else Guide(relaxed=args.relaxed,points=points,diagnostic_seconds=10 if args.selection_test else 15,collect_seconds=6 if args.relative_selection else 3)",
        "68:     renderer = Renderer(buttons=not args.no_buttons,live=args.live,relaxed=args.relaxed,validation=validating,selection_test=args.selection_test,calibration_points=args.calibration_points,relative=args.relative_selection,local_media=args.local_media)",
        "69:     selection=None",
        "70:     menu = None",
        "71:     catalog = Catalog(args.media_dir or root / \"media\") if args.local_media else None",
        "72:     buttons = None",
        "73:     worker, sent_point, compute_sent = None, -1, False",
        "74:     restart = CalibrationRestart()",
        "75:     cleanup_pending = None",
        "76:     tracking = Tracking(reference_cm=(40,43) if args.relative_selection else None)",
        "77:     generation, last_command, last_backend, last_view = None, None, None, None",
        "78:     def begin(now,preview,diagnostic=False):",
        "79:         nonlocal worker,sent_point,compute_sent,generation,cleanup_pending,tracking,menu,selection",
        "80:         if state.phase not in (\"ready\",\"complete\",\"failed\",\"cancelled\",\"checked\",\"validated\",\"usable\",\"validation_failed\",\"restarting\"):",
        "81:             return False",
        "82:         if worker is not None:",
        "91:         sent_point,compute_sent=-1,False",
        "92:         cleanup_pending=None",
        "93:         tracking=Tracking(reference_cm=(40,43) if args.relative_selection else None)",
        "94:         if preview:",
        "95:             state.start(now,preview=True)",
        "96:         else:",
        "107:     signal.signal(signal.SIGTERM,stop)",
        "108:     try:",
        "109:         if not args.no_buttons:",
        "110:             buttons=Buttons()",
        "111:             print(\"buttons=PS_KEY0:%s PS_KEY1:pause\"%(\"start_validation\" if validating else \"start_calibration\" if args.live else \"start_preview\"),flush=True)",
        "112:         overlay = Overlay(str(root/\"overlay/eye_wifi.bit\"))",
        "113:         for name,address in {\"axi_vdma_0\":0x43000000,\"axi_vdma_1\":0x43010000,",
        "114:                              \"live_osd_0\":0x43c00000,\"v_tc_0\":0x43c10000}.items():",
        "115:             if overlay.ip_dict.get(name,{}).get(\"phys_addr\") != address:",
        "116:                 raise RuntimeError(\"Overlay mismatch: \"+name)",
        "117:         initial = renderer.render(state.tick(time.monotonic()))",
        "118:         for _ in range(3):",
        "119:             b=allocate(shape=initial.shape,dtype=np.uint8)",
        "123:         mapped = True",
        "124:         physical=(C.c_uint32*3)(*[b.physical_address for b in buffers])",
        "125:         if not lib.display_open(physical) or not lib.display_park(0):",
        "126:             raise RuntimeError(\"HDMI initialization failed\")",
        "127:         current=0",
