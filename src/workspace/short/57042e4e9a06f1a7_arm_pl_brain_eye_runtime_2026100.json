        "43:             raise ValueError(\"Selection test requires live calibration, without restored model or preview\")",
        "44:         args.relaxed=True",
        "45:     from pynq import Overlay, PL, allocate",
        "46:     import numpy as np",
        "47:     root = Path(__file__).resolve().parents[1]",
        "48:     control = Path(args.control_dir)",
        "51:     for name in (\"command.json\", \"backend.json\"):",
        "52:         (control/name).unlink(missing_ok=True)",
        "53:     lock = open(\"/run/lock/tobii_display.lock\", \"w\")",
        "54:     fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)",
        "55:     original = PL.bitfile_name",
        "56:     if not original or not Path(original).exists():",
        "57:         raise RuntimeError(\"Original overlay unavailable\")",
        "58:     lib = C.CDLL(str(root/\"libtobii_display.so\"))",
        "59:     lib.display_open.argtypes = [C.POINTER(C.c_uint32)]",
