        "27:     parser.add_argument(\"--selection-test\",action=\"store_true\",help=\"Calibrate then keep streaming to a three-region dwell test\")",
        "28:     parser.add_argument(\"--relative-selection\",action=\"store_true\",help=\"Board-only three horizontal anchors from available live gaze; no OEM model compute\")",
        "29:     parser.add_argument(\"--local-media\", action=\"store_true\", help=\"Relative gaze menus with SD-card speech, silent video and music\")",
